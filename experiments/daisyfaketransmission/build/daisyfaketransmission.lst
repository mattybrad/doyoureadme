  24:daisyfaketransmission.cpp **** void AudioCallback(AudioHandle::InputBuffer in, AudioHandle::OutputBuffer out, size_t size)
  25:daisyfaketransmission.cpp **** {
  26:daisyfaketransmission.cpp **** 	// store audio in current window
  27:daisyfaketransmission.cpp **** 	for (size_t i = 0; i < size; i++)
  28:daisyfaketransmission.cpp **** 	{
  29:daisyfaketransmission.cpp **** 		storedAudio[i] = in[0][i];
  30:daisyfaketransmission.cpp **** 	}
  31:daisyfaketransmission.cpp **** 
  32:daisyfaketransmission.cpp **** 	decodeAudio();
  33:daisyfaketransmission.cpp **** 	for (size_t i = 0; i < size; i++)
  34:daisyfaketransmission.cpp **** 	{
  35:daisyfaketransmission.cpp **** 		out[0][i] = decodedAudio[i];
  36:daisyfaketransmission.cpp **** 		out[1][i] = decodedAudio[i];
  37:daisyfaketransmission.cpp **** 	}
  38:daisyfaketransmission.cpp **** 
  39:daisyfaketransmission.cpp **** 	encodedAudioIndex = 0;
  40:daisyfaketransmission.cpp **** }
  41:daisyfaketransmission.cpp **** 
  42:daisyfaketransmission.cpp **** void decodeAudio() {
  43:daisyfaketransmission.cpp **** 	for(int i=0; i<audioBlockSize; i++) {
  44:daisyfaketransmission.cpp **** 		decodedAudio[i] = ((float)encodedAudio[i] / 127.5f) - 1.0f;
  45:daisyfaketransmission.cpp **** 	}
  46:daisyfaketransmission.cpp **** }
